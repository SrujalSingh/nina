<%- include('../layouts/header') %>

<div class="container" style="padding: 7rem 1.5rem; text-align: center; max-width: 600px;">
  <span class="subheading" style="color: var(--accent-gold);">404 Error</span>
  <h1 class="heading-xl" style="margin-top: 0.5rem; margin-bottom: 1rem;">Piece Not Found</h1>
  <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.7; margin-bottom: 2rem;">
    <%= typeof message !== 'undefined' ? message : 'The piece or collection you are looking for does not exist or has been archived.' %>
  </p>
  <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
    <a href="/" class="btn btn-primary">Return to Homepage</a>
    <a href="/shop" class="btn btn-outline">Browse Collection</a>
  </div>
</div>

<%- include('../layouts/footer') %>
