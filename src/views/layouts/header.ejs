<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Nina Weaves | Handcrafted Luxury Shirts & Bespoke Textiles' %></title>
  <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
    <meta name="description" content="<%= metaDescription %>">
  <% } else { %>
    <meta name="description" content="Mastercrafted luxury shirts and museum-grade textile swatches. Tailored from rare Egyptian Giza cotton and pure Belgian linen, ordered via WhatsApp.">
  <% } %>
  <link rel="canonical" href="https://nestbeans.com<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/logo.png">
  
  <!-- Styles -->
  <link rel="stylesheet" href="/css/storefront.css">
  
  <script>
    window.NINA_WHATSAPP_NUMBER = "<%= (settings && settings.whatsapp_number) ? settings.whatsapp_number : '919876543210' %>";
  </script>
</head>
<body>

  <!-- Header Navigation -->
  <header class="site-header">
    <div class="container header-inner">
      <!-- Logo -->
      <a href="/" class="header-brand" aria-label="Nina Weaves Atelier Home">
        <img src="/images/logo.png" alt="Nina Weaves Logo" class="brand-logo-img">
      </a>

      <!-- Primary Navigation -->
      <nav>
        <ul class="nav-links">
          <li><a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
          
          <!-- Shop All Dropdown (Shirts, Pants, Jeans) -->
          <li class="nav-item-dropdown">
            <a href="/shop" class="nav-link dropdown-toggle <%= (currentPath === '/shop' || currentPath.includes('shirts') || currentPath.includes('pants') || currentPath.includes('jeans')) && !currentPath.includes('fabric') ? 'active' : '' %>">
              Shop All
              <svg class="dropdown-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 1L5 5L9 1"/>
              </svg>
            </a>
            <ul class="dropdown-menu">
              <li><a href="/shop" class="dropdown-link">All Products</a></li>
              <li><a href="/shop?category=shirts" class="dropdown-link">Shirts</a></li>
              <li><a href="/shop?category=pants" class="dropdown-link">Pants</a></li>
              <li><a href="/shop?category=jeans" class="dropdown-link">Jeans</a></li>
            </ul>
          </li>

          <!-- Fabric Samples Dropdown (Shirting Fabric, Suiting Fabric, Denim/Jeans Fabric) -->
          <li class="nav-item-dropdown">
            <a href="/shop?category=fabric-samples" class="nav-link dropdown-toggle <%= currentPath.includes('fabric-samples') ? 'active' : '' %>">
              Fabric Samples
              <svg class="dropdown-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 1L5 5L9 1"/>
              </svg>
            </a>
            <ul class="dropdown-menu">
              <li><a href="/shop?category=fabric-samples" class="dropdown-link">All Fabric Samples</a></li>
              <li><a href="/shop?category=fabric-samples&subcategory=Shirting+Fabric" class="dropdown-link">Shirting Fabric</a></li>
              <li><a href="/shop?category=fabric-samples&subcategory=Suiting+Fabric" class="dropdown-link">Suiting Fabric</a></li>
              <li><a href="/shop?category=fabric-samples&subcategory=Denim%2FJeans+Fabric" class="dropdown-link">Denim/Jeans Fabric</a></li>
            </ul>
          </li>

          <li><a href="/about" class="nav-link <%= currentPath === '/about' ? 'active' : '' %>">About Atelier</a></li>
          <li><a href="/contact" class="nav-link <%= currentPath === '/contact' ? 'active' : '' %>">Contact</a></li>
        </ul>
      </nav>

      <!-- Action Icons -->
      <div class="header-actions">
        <!-- Search Link -->
        <a href="/shop" class="header-icon-btn" title="Search Catalogue" aria-label="Search Catalogue">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>

        <!-- Cart Bag -->
        <a href="/cart" class="header-icon-btn" title="View Shopping Bag" aria-label="Shopping Bag">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="cart-count-badge" style="display: none;">0</span>
        </a>

        <!-- Mobile Menu Button -->
        <button type="button" class="mobile-menu-btn" aria-label="Toggle Navigation">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </header>
  <main>
