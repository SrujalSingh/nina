<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Nina Weaves | Handcrafted Luxury Shirts & Bespoke Textiles' %></title>
  <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
    <meta name="description" content="<%= metaDescription %>">
  <% } else { %>
    <meta name="description" content="Mastercrafted luxury shirts and museum-grade textile swatches. Tailored from rare Egyptian Giza cotton and pure Belgian linen, ordered via WhatsApp.">
  <% } %>
  <link rel="canonical" href="https://nestbeans.com<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  
  <!-- Styles -->
  <link rel="stylesheet" href="/css/storefront.css">
  
  <script>
    window.NINA_WHATSAPP_NUMBER = "<%= (settings && settings.whatsapp_number) ? settings.whatsapp_number : '919876543210' %>";
  </script>
</head>
<body>

  <!-- Top Announcement Bar -->
  <div class="announcement-bar">
    <span><%= (settings && settings.announcement_text) ? settings.announcement_text : 'Complimentary shipping on orders above ₹2,500 | Dedicated WhatsApp Stylist Available' %></span>
    <a href="https://wa.me/<%= (settings && settings.whatsapp_number) ? settings.whatsapp_number : '919876543210' %>?text=Hello%20Atelier%20Nina%20Weaves,%20I%20would%20like%20to%20consult%20with%20a%20stylist." target="_blank">Chat with Stylist →</a>
  </div>

  <!-- Header Navigation -->
  <header class="site-header">
    <div class="container header-inner">
      <!-- Logo -->
      <a href="/" class="header-brand">
        <img src="/images/logo.svg" alt="Nina Weaves Logo">
      </a>

      <!-- Primary Navigation -->
      <nav>
        <ul class="nav-links">
          <li><a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
          <li><a href="/shop" class="nav-link <%= currentPath === '/shop' && (!currentPath.includes('shirts') && !currentPath.includes('fabric')) ? 'active' : '' %>">Shop All</a></li>
          <li><a href="/shop?category=shirts" class="nav-link <%= currentPath.includes('shirts') ? 'active' : '' %>">Shirts</a></li>
          <li><a href="/shop?category=fabric-samples" class="nav-link <%= currentPath.includes('fabric-samples') ? 'active' : '' %>">Fabric Samples</a></li>
          <li><a href="/about" class="nav-link <%= currentPath === '/about' ? 'active' : '' %>">About Atelier</a></li>
          <li><a href="/contact" class="nav-link <%= currentPath === '/contact' ? 'active' : '' %>">Contact</a></li>
        </ul>
      </nav>

      <!-- Action Icons -->
      <div class="header-actions">
        <!-- Search Link -->
        <a href="/shop" class="header-icon-btn" title="Search Catalogue" aria-label="Search Catalogue">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>

        <!-- Cart Bag -->
        <a href="/cart" class="header-icon-btn" title="View Shopping Bag" aria-label="Shopping Bag">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="cart-count-badge" style="display: none;">0</span>
        </a>

        <!-- Mobile Menu Button -->
        <button type="button" class="mobile-menu-btn" aria-label="Toggle Navigation">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </header>
  <main>
