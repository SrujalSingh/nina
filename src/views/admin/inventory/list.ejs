<%- include('../../layouts/admin-header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="font-size: 1.5rem; font-weight: 700;">Inventory &amp; Stock Management</h1>
    <p style="color: var(--admin-text-muted); font-size: 0.88rem;">Live stock records for each size, fabric quality, and swatch cut. All adjustments record a strict audit trail.</p>
  </div>
  <a href="/admin/stock-history" class="admin-btn admin-btn-secondary">
    📜 View Stock Movement History
  </a>
</div>

<!-- Search & Filters Toolbar -->
<div class="panel" style="margin-bottom: 1.5rem;">
  <div class="panel-body" style="padding: 1rem 1.5rem;">
    <form action="/admin/inventory" method="GET" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
      <div style="flex-grow: 1; min-width: 220px;">
        <input type="text" name="search" value="<%= search %>" placeholder="Search by SKU, product name, or quality..." class="admin-input">
      </div>

      <div style="min-width: 170px;">
        <select name="category" class="admin-select">
          <option value="">All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>" <%= currentCategory == cat.id ? 'selected' : '' %>><%= cat.name %></option>
          <% }) %>
        </select>
      </div>

      <div style="min-width: 170px;">
        <select name="filter" class="admin-select">
          <option value="all" <%= currentFilter === 'all' ? 'selected' : '' %>>All Stock Statuses</option>
          <option value="low_stock" <%= currentFilter === 'low_stock' ? 'selected' : '' %>>⚠️ Low-Stock Only</option>
          <option value="out_of_stock" <%= currentFilter === 'out_of_stock' ? 'selected' : '' %>>🚫 Out-of-Stock Only</option>
        </select>
      </div>

      <button type="submit" class="admin-btn admin-btn-secondary">Apply Filters</button>
      <a href="/admin/inventory" class="admin-btn admin-btn-secondary">Reset</a>
    </form>
  </div>
</div>

<!-- Stock Records Table -->
<div class="panel">
  <div class="panel-body" style="padding: 0;">
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th style="width: 50px;">Photo</th>
            <th>Product &amp; Category</th>
            <th>Variation SKU</th>
            <th>Size</th>
            <th>Fabric Quality / Option</th>
            <th>Current Stock</th>
            <th>Threshold</th>
            <th>Availability</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (items && items.length > 0) { %>
            <% items.forEach(item => { %>
              <tr>
                <td>
                  <img src="<%= item.primary_image || '/uploads/products/shirt-oxford-1.svg' %>" alt="" style="width: 36px; height: 44px; object-fit: cover; border-radius: 4px; border: 1px solid #E2E8F0;">
                </td>
                <td>
                  <div style="font-weight: 700;"><%= item.product_name %></div>
                  <small style="color: #64748B;"><%= item.category_name %> • Unit: <%= item.unit %></small>
                </td>
                <td><code style="font-family: monospace; font-weight: 600;"><%= item.variation_sku %></code></td>
                <td><strong><%= item.size || '—' %></strong></td>
                <td>
                  <div><%= item.quality %></div>
                  <% if (item.option_name) { %><small style="color:#64748B;"><%= item.option_name %></small><% } %>
                </td>
                <td>
                  <strong style="color: <%= item.stock_quantity === 0 ? '#EF4444' : (item.stock_quantity <= item.low_stock_threshold ? '#F59E0B' : '#10B981') %>; font-size: 1.15rem;">
                    <%= item.stock_quantity %>
                  </strong> units
                </td>
                <td><%= item.low_stock_threshold %></td>
                <td>
                  <% if (item.stock_quantity === 0) { %>
                    <span class="admin-badge badge-out">Sold Out</span>
                  <% } else if (item.stock_quantity <= item.low_stock_threshold) { %>
                    <span class="admin-badge badge-low">Low Stock</span>
                  <% } else { %>
                    <span class="admin-badge badge-active">Available</span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <button type="button" class="admin-btn admin-btn-sm admin-btn-primary" 
                    onclick="openStockModal('<%= item.variation_id %>', '<%= item.variation_sku %>', '<%= item.stock_quantity %>', '<%= item.product_name %>')">
                    Adjust Stock
                  </button>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="9" style="text-align: center; padding: 3rem; color: #64748B;">
                No inventory records found matching your filters.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../../layouts/admin-footer') %>
