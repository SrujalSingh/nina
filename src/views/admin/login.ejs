<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Admin Sign In | Nina Weaves Portal' %></title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
</head>
<body style="background-color: #0F172A; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 1.5rem;">

  <div style="width: 100%; max-width: 420px; background-color: #FFF; border-radius: 12px; padding: 2.5rem; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);">
    <div style="text-align: center; margin-bottom: 2rem;">
      <img src="/images/logo.svg" alt="Nina Weaves" style="height: 42px; margin: 0 auto 1rem auto;">
      <h1 style="font-size: 1.35rem; font-weight: 700; color: #0F172A;">Store Management Portal</h1>
      <p style="font-size: 0.85rem; color: #64748B; margin-top: 0.25rem;">Sign in with your administrative credentials</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error" style="margin-bottom: 1.5rem;">
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="admin-form-group">
        <label class="admin-label" for="username">Username</label>
        <input type="text" id="username" name="username" class="admin-input" value="<%= typeof username !== 'undefined' ? username : '' %>" required autofocus placeholder="Admin username">
      </div>

      <div class="admin-form-group">
        <label class="admin-label" for="password">Password</label>
        <input type="password" id="password" name="password" class="admin-input" required placeholder="••••••••••••">
      </div>

      <div style="margin-top: 2rem;">
        <button type="submit" class="admin-btn admin-btn-primary" style="width: 100%; padding: 0.8rem; font-size: 0.95rem;">
          Sign In to Portal
        </button>
      </div>
    </form>

    <div style="margin-top: 2rem; border-top: 1px solid #E2E8F0; padding-top: 1.25rem; text-align: center;">
      <a href="/" style="font-size: 0.82rem; color: #64748B; text-decoration: underline;">← Return to Customer Storefront</a>
    </div>
  </div>

</body>
</html>
