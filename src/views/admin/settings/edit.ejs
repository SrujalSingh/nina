<%- include('../../layouts/admin-header') %>

<div style="margin-bottom: 1.5rem;">
  <h1 style="font-size: 1.5rem; font-weight: 700;">Store Settings &amp; Business Details</h1>
  <p style="color: var(--admin-text-muted); font-size: 0.88rem;">Configure brand metadata, WhatsApp concierge phone number, contact details, and currency.</p>
</div>

<div class="panel" style="max-width: 800px;">
  <div class="panel-header">
    <div class="panel-title">Business &amp; WhatsApp Configuration</div>
  </div>
  <div class="panel-body">
    <form action="/admin/settings" method="POST">
      
      <div class="form-grid">
        <div class="admin-form-group">
          <label class="admin-label" for="brand_name">Brand Name *</label>
          <input type="text" id="brand_name" name="brand_name" class="admin-input" value="<%= (settings && settings.brand_name) ? settings.brand_name : 'Nina Weaves' %>" required>
        </div>

        <div class="admin-form-group">
          <label class="admin-label" for="brand_tagline">Brand Tagline</label>
          <input type="text" id="brand_tagline" name="brand_tagline" class="admin-input" value="<%= (settings && settings.brand_tagline) ? settings.brand_tagline : '' %>">
        </div>

        <div class="admin-form-group">
          <label class="admin-label" for="whatsapp_number">Business WhatsApp Number *</label>
          <input type="text" id="whatsapp_number" name="whatsapp_number" class="admin-input" value="<%= (settings && settings.whatsapp_number) ? settings.whatsapp_number : '919876543210' %>" required placeholder="919876543210">
          <div class="admin-help">Include country code without + or spaces (e.g. 919876543210 for India). Orders on WhatsApp will route to this number.</div>
        </div>

        <div class="admin-form-group">
          <label class="admin-label" for="contact_phone">Customer Care Phone</label>
          <input type="text" id="contact_phone" name="contact_phone" class="admin-input" value="<%= (settings && settings.contact_phone) ? settings.contact_phone : '+91 98765 43210' %>">
        </div>

        <div class="admin-form-group">
          <label class="admin-label" for="contact_email">Official Atelier Email</label>
          <input type="email" id="contact_email" name="contact_email" class="admin-input" value="<%= (settings && settings.contact_email) ? settings.contact_email : 'contact@nestbeans.com' %>">
        </div>

        <div class="admin-form-group">
          <label class="admin-label" for="currency">Store Currency</label>
          <input type="text" id="currency" name="currency" class="admin-input" value="<%= (settings && settings.currency) ? settings.currency : 'INR' %>" readonly style="background:#F1F5F9;">
        </div>

        <div class="admin-form-group">
          <label class="admin-label" for="currency_symbol">Currency Symbol</label>
          <input type="text" id="currency_symbol" name="currency_symbol" class="admin-input" value="<%= (settings && settings.currency_symbol) ? settings.currency_symbol : '₹' %>" readonly style="background:#F1F5F9;">
        </div>

        <div class="admin-form-group">
          <label class="admin-label" for="low_stock_threshold_default">Default Low-Stock Threshold</label>
          <input type="number" id="low_stock_threshold_default" name="low_stock_threshold_default" class="admin-input" value="<%= (settings && settings.low_stock_threshold_default) ? settings.low_stock_threshold_default : '5' %>" min="1">
          <div class="admin-help">Variations with stock below this number trigger alert flags.</div>
        </div>
      </div>

      <div class="admin-form-group" style="margin-top: 1rem;">
        <label class="admin-label" for="contact_address">Atelier Physical Address</label>
        <textarea id="contact_address" name="contact_address" rows="2" class="admin-textarea"><%= (settings && settings.contact_address) ? settings.contact_address : '' %></textarea>
      </div>

      <div style="margin-top: 2rem;">
        <button type="submit" class="admin-btn admin-btn-primary admin-btn-lg">Save Settings</button>
      </div>
    </form>
  </div>
</div>

<%- include('../../layouts/admin-footer') %>
